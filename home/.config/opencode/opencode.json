{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["opencode-websearch"],
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "gh pr create *": "ask",
      "gh pr merge *": "ask",
      "gh pr close *": "ask",
      "gh pr comment *": "ask",
      "gh pr review *": "ask",
      "gh pr edit *": "ask",
      "gh issue create *": "ask",
      "gh issue close *": "ask",
      "gh issue comment *": "ask",
      "gh issue edit *": "ask",
      "gh release create *": "ask",
      "gh release edit *": "ask",
      "gh release delete *": "ask",
      "gh release upload *": "ask",
      "gh repo create *": "ask",
      "gh repo edit *": "ask",
      "gh repo rename *": "ask",
      "gh repo archive *": "ask",
      "gh repo fork *": "ask",
      "gh repo sync *": "ask",
      "gh api *": "ask",
      "mise dot apply *": "ask",
      "mise bs *": "ask",
      "mise bootstrap *": "ask",
      "git push *--force*": "deny",
      "git push -f *": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git push * +*": "deny",
      "gh repo delete *": "deny"
    }
  }
}
